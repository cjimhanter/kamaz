# Публичные контакты на сайте
SITE_PHONE=+7 900 000-00-00
SITE_PHONE_TEL=+79000000000
SITE_CITY=Иркутск и Иркутская область
SITE_NAME=Камаз. Щебень

# VK: сообщество → Управление → Работа с API → ключ доступа (право «сообщения сообщества»).
# Отец один раз пишет в сообщения сообщества. VK_PEER_ID = его числовой id (или peer_id беседы).
VK_ACCESS_TOKEN=
VK_PEER_ID=

# MAX: бот в «MAX для бизнеса», токен из расширенных настроек.
# Отец пишет боту. MAX_USER_ID — его id; либо MAX_CHAT_ID, если шлём в чат.
MAX_BOT_TOKEN=
MAX_USER_ID=
MAX_CHAT_ID=

# SQLite
DATABASE_PATH=data/leads.db
